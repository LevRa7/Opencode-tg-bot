[Unit]
Description=OpenCode Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=me
WorkingDirectory=/home/me/MyProjects/opencode-tg/main
ExecStart=/usr/bin/npx tsx run-bot.ts
Restart=always
RestartSec=10
StandardOutput=append:/tmp/bot-systemd.log
StandardError=append:/tmp/bot-systemd.log
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
